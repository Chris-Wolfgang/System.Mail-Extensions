# Analyzer rules relaxed for benchmark projects
#
# BenchmarkDotNet code deliberately trips several analyzers: measured methods
# are intentionally naive, are invoked by reflection, and memory diagnostics
# read GC counters directly. This file silences only those genuinely
# benchmark-inappropriate rules so the project can be held to
# TreatWarningsAsErrors in Release alongside src/ and tests/.
# Canonical parallel to tests/.editorconfig.

[*.cs]

# AsyncFixer01: Remove async/await — benchmark methods follow BenchmarkDotNet conventions
dotnet_diagnostic.AsyncFixer01.severity = none

# MA0004: Use ConfigureAwait(false) — not needed in a benchmark harness
dotnet_diagnostic.MA0004.severity = none

# CA2007: Consider calling ConfigureAwait — same rationale as MA0004
dotnet_diagnostic.CA2007.severity = none

# S1215: Remove use of GC.GetTotalMemory / GC.Collect — required for memory benchmarks
dotnet_diagnostic.S1215.severity = none

# CA1822: Mark members as static — [Benchmark] methods must be instance methods
dotnet_diagnostic.CA1822.severity = none

# CA1024: Use properties where appropriate — a parameterless, value-returning
# [Benchmark] method is a BenchmarkDotNet entry point, not a property candidate
dotnet_diagnostic.CA1024.severity = none

# VSTHRD200: Use Async suffix — benchmark methods follow BenchmarkDotNet naming conventions
dotnet_diagnostic.VSTHRD200.severity = none

# -----------------------------------------------------------------------
# InspectCode-only suppressions. Same rationale as tests/.editorconfig:
# InspectCode doesn't read csproj <NoWarn> or the Directory.Build.props
# Exists() gate on PublicApiAnalyzer AdditionalFiles.
# -----------------------------------------------------------------------

# RS0016 / RS0037: PublicApiAnalyzer — opt-in per project via Exists() gate
# in Directory.Build.props. Benchmark projects have no PublicAPI.Shipped.txt
# and are not part of the tracked public surface.
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0037.severity = none

# -----------------------------------------------------------------------
# ReSharper-native inspections. Benchmark [Params] properties look
# "publicly assigned but never read" to R# — BenchmarkDotNet reflects
# on them at runtime.
# -----------------------------------------------------------------------

# UnusedAutoPropertyAccessor.Global: [Params] properties are populated by
# BenchmarkDotNet via reflection, not by explicit callers.
resharper_unused_auto_property_accessor_global_highlighting = none

# RedundantUsingDirective: benchmark files use different imports per TFM
# slice; kept for consistency across the benchmark project.
resharper_redundant_using_directive_highlighting = none

# ConditionalAccessQualifierIsNonNullableAccordingToAPIContract: benchmark
# code sometimes uses defensive null-safe access on values the nullable
# contract says can't be null, to be robust across runtime differences.
resharper_conditional_access_qualifier_is_non_nullable_according_to_api_contract_highlighting = none
